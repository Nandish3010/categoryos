# Mock mode: nothing needed. Run `make dev` with no keys and the backend serves canned results.
MODEL_MODE=mock

# Live mode (costs credits): set MODEL_MODE=live and fill these in
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
LIVE_STAGES=
WARN_SPEND_USD=100
MAX_SPEND_USD=120
CALL_BUDGET_USD=2

# Public live budget (opt-in; replay deploy only needs MODEL_API_KEY for these). Lets visitors try BYO vendors and the live
# call copilot WITHOUT the demo key, up to these limits. 0 = disabled (default). MAX_SPEND_USD always applies on top.
PUBLIC_LIVE_BUDGET_USD=0
PUBLIC_LIVE_PER_IP_USD=0.50
PUBLIC_LIVE_FEATURES=

# Deploy
DEMO_KEY=
FRONTEND_ORIGIN=
BACKEND_PORT=8001
